# Copy to .env and fill in real values locally. Never commit .env.
# Empty values are treated as "not set".

# Gemini runtime
GEMINI_API_KEY=replace_with_your_new_gemini_key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_OUTPUT_DIMENSION=768

# RAG / FAISS (experimental starting values — see docs/experiment_log.md)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
# Leave empty until calibrated (Sprint 3–5). L2 distance, not a probability.
RETRIEVAL_MAX_L2_DISTANCE=
# Root folder of versioned indexes; the active one is named in data/index/ACTIVE
FAISS_INDEX_PATH=data/index
KNOWLEDGE_BASE_PATH=data/source/handbook.pdf
PDF_MAX_UPLOAD_MB=30
QUESTION_MAX_CHARS=500
OCR_MIN_TEXT_CHARS_PER_PAGE=40
# Resolution used to render scanned pages before OCR (see docs/experiment_log.md EXP-001)
OCR_RENDER_DPI=200
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe (empty = use PATH)
TESSERACT_CMD=
TESSERACT_LANG=ind+eng

# Admin — one account only. Never commit actual values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_secret

# Ragas evaluator — used only by evaluation scripts
OPENAI_API_KEY=replace_with_your_new_openai_key
OPENAI_EVAL_MODEL=gpt-4o-mini
OPENAI_EVAL_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_DATASET_PATH=data/evaluation/ground_truth.jsonl

# Document export (scripts/export_docs.py) — personal identifiers, kept out of the public repo
NIM_DEVELOPER=
NIP_PRODUCT_OWNER=

# Operational
APP_ENV=development
LOG_LEVEL=INFO
